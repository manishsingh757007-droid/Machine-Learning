   "source": [
    "from sklearn.ensemble import RandomForestClassifier\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "71d90a55-1c43-4b86-a692-af2ee80e3091",
   "metadata": {},
   "outputs": [],
   "source": [
    " df = pd.read_csv(\"housing.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "f415b3bf-d6cc-4942-8b7c-951f0ff01f13",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"income_cat\"]=pd.cut(df[\"median_income\"],bins=[0,1.5,3.0,4.5,6.0,np.inf],labels=[1,2,3,4,5])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "518421ad-16af-4a43-b91f-9ecf2b8e3bd3",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import StratifiedShuffleSplit\n",
    "split = StratifiedShuffleSplit(n_splits=1,test_size=0.2,random_state=42)\n",
    "for train_index,test_index in split.split(df,df[\"income_cat\"]): \n",
    "  start_train_set = df.loc[train_index]\n",
    "  start_test_set= df.loc[test_index]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "72362cff-0fe5-452c-aaaf-e4bad8bfcc96",
   "metadata": {},
   "outputs": [],
   "source": [
    "for sett in(start_train_set,start_test_set):\n",
    "    \n",
    "   sett.drop(\"income_cat\",axis = 1,inplace = True)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "9da34889-96bd-4abd-aeff-627f49e719bd",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = start_train_set.copy()"
   ]
  },
